  _meshProUGUI: {fileID: 405926057}
  _voicePlayer: {fileID: 46625092}
  _messageWindow: {fileID: 46625089}
  _dialogueData:
  - text: "\u3088\u3049\u3001\u611B\u6A5F\u306E\u8ABF\u5B50\u306F\u3069\u3046\u3060?"
    exprressionName: Netural
    voiceClip: {fileID: 8300000, guid: 9d2f08dd8b0e86c40a83f5f259293b33, type: 3}
  - text: "\u6765\u305F\u306A\u3002\u4ECA\u65E5\u306F\u3069\u3053\u3092\u3044\u3058\u308B\u3093\u3060\uFF1F"
    exprressionName: Netural
    voiceClip: {fileID: 8300000, guid: d16b19905ae05014392411c5d01e52c6, type: 3}
  _idleDialogueData:
  - text: "\u3075\u3045\u3001\u3084\u3063\u3071\u308A\u3053\u306E\u4ED5\u4E8B\u3001\u6027\u306B\u5408\u3063\u3066\u308B\u308F"
    exprressionName: Smile
    voiceClip: {fileID: 8300000, guid: 607f8069cf75d4b46ba5e03eeef0daa5, type: 3}
  - text: "\u3061\u3087\u3063\u3068\u4F11\u61A9\u3059\u308B\u304B\u2026\u3063\u3066\u3001\u3042\u3093\u305F\u307E\u3060\u3053\u3053\u306B\u3044\u305F\u306E\u304B\uFF1F"
    exprressionName: Confused
    voiceClip: {fileID: 8300000, guid: 39e3b95fbbfc4c041990ba370ea77978, type: 3}
  - text: "\u307E\u3001\u3069\u308C\u3060\u3051\u624B\u3053\u305A\u3063\u3066\u3082\u3001\u6A5F\u68B0\u306F\u5618\u3092\u3064\u304B\u306A\u3044\u304B\u3089\u697D\u3060\u306D\u3047"
    exprressionName: Netural
    voiceClip: {fileID: 8300000, guid: ade08509dcd21ae4da95e7fc70bef0d4, type: 3}
  - text: "\u3055\u3066\u3001\u6642\u9593\u304C\u304B\u304B\u308A\u305D\u3046\u306A\u3089\u3001\u30B3\u30FC\u30D2\u30FC\u3067\u3082\u6DF9\u308C\u3088\u3046\u304B\uFF1F"
    exprressionName: Netural
    voiceClip: {fileID: 8300000, guid: e28777f9d7ee37e4ebc1e9c8bf7dc4ae, type: 3}
  - text: "\u6687\u306A\u3089\u624B\u4F1D\u3063\u3066\u304F\u308C\u3066\u3082\u3044\u3044\u3093\u3060\u305C\u3002\u307E\u3001\u671F\u5F85\u3057\u3066\u306A\u3044\u3051\u3069\u306A\uFF01"
    exprressionName: Smile
    voiceClip: {fileID: 8300000, guid: a08c3f3a966b26c4b98c6bd05a19e5db, type: 3}
